#!/usr/bin/env fish

set -l executable_file (path resolve (status filename))
set -l package_root (path dirname (path dirname $executable_file))
source "$package_root/conf.d/spacewright.fish"
or exit 1

set -l command_name $argv[1]
if test -n "$command_name"
    set -e argv[1]
else
    set command_name help
end

switch "$command_name"
    case version --version -v
        string trim < "$package_root/VERSION"
    case config-check
        workspace_config_check
    case config-plan
        workspace_config_plan $argv
    case config-v2-check
        set -l config_file $argv[1]
        test -n "$config_file"; or set config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v2.json"
        command node "$package_root/configurator/cli.mjs" validate "$config_file"
    case config-v2-compile
        set -l config_file $argv[1]
        test -n "$config_file"; or set config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v2.json"
        command node "$package_root/configurator/cli.mjs" compile "$config_file"
    case config-compile
        set -l config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v2.json"
        set -l runtime_file "$SPACEWRIGHT_CONFIG_ROOT/generated/runtime.json"
        command node "$package_root/configurator/cli.mjs" compile-to "$config_file" "$runtime_file"
        and printf 'compiled=%s\n' "$runtime_file"
    case config-status
        spacewright_config_status
    case config-diff
        set -l config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v2.json"
        set -l runtime_file "$SPACEWRIGHT_CONFIG_ROOT/generated/runtime.json"
        if not test -r "$config_file"
            echo 'spacewright: config-diff requires config.v2.json' >&2
            exit 1
        end
        if not command -q node
            echo 'spacewright: config-diff requires Node.js to compile the candidate plan' >&2
            exit 1
        end
        set -l candidate (mktemp -t spacewright-runtime.XXXXXX)
        command node "$package_root/configurator/cli.mjs" compile-to "$config_file" "$candidate"
        or exit 1
        diff -u "$runtime_file" "$candidate"
        set -l diff_status $status
        command rm -f "$candidate"
        if test "$diff_status" -eq 0
            echo 'runtime is current'
        else if test "$diff_status" -gt 1
            exit "$diff_status"
        end
    case config-explain
        if test (count $argv) -ne 2
            echo 'usage: spacewright config-explain <workspace> <solo|wide|tall>' >&2
            exit 2
        end
        set -l config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v2.json"
        set -l runtime_id
        if test -r "$config_file"
            set runtime_id (jq -r --arg workspace "$argv[1]" --arg mode "$argv[2]" '.workspaces[$workspace].variants[$mode] as $variant | if $variant then ($variant.command // ("spacewright_" + $workspace + "_" + $mode)) else empty end' "$config_file")
        else
            set runtime_id (spacewright_config_effective | jq -r --arg workspace "$argv[1]" --arg mode "$argv[2]" 'first(.workspaces | to_entries[] | select(.value.ui.workspace_id == $workspace and .value.ui.mode == $mode) | .key) // empty')
        end
        if test -z "$runtime_id"
            echo "spacewright: no configured variant for $argv[1] $argv[2]" >&2
            exit 1
        end
        workspace_config_plan "$runtime_id"
    case inspect
        command node "$package_root/configurator/state-cli.mjs" inspect \
            "--package-root=$package_root" \
            "--config-root=$SPACEWRIGHT_CONFIG_ROOT" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT" \
            $argv
    case plan
        command node "$package_root/configurator/state-cli.mjs" plan \
            "--package-root=$package_root" \
            "--config-root=$SPACEWRIGHT_CONFIG_ROOT" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT" \
            $argv
    case verify
        command node "$package_root/configurator/state-cli.mjs" verify \
            "--package-root=$package_root" \
            "--config-root=$SPACEWRIGHT_CONFIG_ROOT" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT" \
            $argv
    case capture
        command node "$package_root/configurator/state-cli.mjs" capture \
            "--package-root=$package_root" \
            "--config-root=$SPACEWRIGHT_CONFIG_ROOT" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT" \
            $argv
    case apply
        command node "$package_root/configurator/state-cli.mjs" apply \
            "--package-root=$package_root" \
            "--config-root=$SPACEWRIGHT_CONFIG_ROOT" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT" \
            $argv
    case event
        command node "$package_root/configurator/state-cli.mjs" event \
            "--package-root=$package_root" \
            "--config-root=$SPACEWRIGHT_CONFIG_ROOT" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT" \
            $argv
    case recover
        command node "$package_root/configurator/state-cli.mjs" recover \
            "--package-root=$package_root" \
            "--config-root=$SPACEWRIGHT_CONFIG_ROOT" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT" \
            $argv
    case display
        set -l profile $argv[1]
        if not contains -- "$profile" solo wide_left tall_left
            echo 'usage: spacewright display <solo|wide_left|tall_left> [--dry-run]' >&2
            exit 2
        end
        if contains -- --dry-run $argv
            printf 'dry_run=display_apply_%s\n' "$profile"
            exit 0
        end
        switch "$profile"
            case solo
                display_apply_solo
            case wide_left
                display_apply_wide_left
            case tall_left
                display_apply_tall_left
        end
    case focus
        if test (count $argv) -lt 2
            echo 'usage: spacewright focus <workspace> <solo|wide|tall> [--dry-run]' >&2
            exit 2
        end
        set -l workspace_id $argv[1]
        set -l mode $argv[2]
        if not contains -- "$mode" solo wide tall
            echo 'spacewright: focus mode must be solo, wide, or tall' >&2
            exit 2
        end
        set -l config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v2.json"
        if not test -r "$config_file"
            echo 'spacewright: focus requires config.v2.json' >&2
            exit 1
        end
        set -l label (jq -r --arg workspace "$workspace_id" --arg mode "$mode" '.workspaces[$workspace] as $w | $w.variants[$mode] as $v | if ($w and $v) then ($v.spaceLabel // ($w.spaceLabel + "_" + $mode)) else empty end' "$config_file")
        if test -z "$label"
            echo "spacewright: no configured variant for $workspace_id $mode" >&2
            exit 1
        end
        if contains -- --dry-run $argv
            printf 'dry_run=focus_space\nlabel=%s\n' "$label"
            exit 0
        end
        command yabai -m space --focus "$label"
    case config-migrate-v1
        set -l config_file $argv[1]
        test -n "$config_file"; or set config_file (spacewright_config_user_file)
        command node "$package_root/configurator/cli.mjs" migrate-v1 "$config_file"
    case configure
        if not command -q node
            echo 'spacewright configure requires Node.js 20 or newer' >&2
            exit 1
        end
        command node "$package_root/configurator/server.mjs" "--package-root=$package_root" "--config-root=$SPACEWRIGHT_CONFIG_ROOT" "--state-root=$SPACEWRIGHT_STATE_ROOT" $argv
    case run
        if string match -q 'work_*' -- "$argv[1]"
            workspace_run_configured_mode $argv
        else if contains -- "$argv[2]" solo wide tall
            set -l workspace_id $argv[1]
            set -l mode $argv[2]
            set -e argv[1..2]
            set -l runtime_id "$workspace_id"_"$mode"
            set -l config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v2.json"
            if test -r "$config_file"
                set runtime_id (jq -r --arg workspace "$workspace_id" --arg mode "$mode" '.workspaces[$workspace].variants[$mode] as $variant | if $variant then ($variant.command // ("spacewright_" + $workspace + "_" + $mode)) else empty end' "$config_file")
            end
            if test -z "$runtime_id"
                echo "spacewright: no configured variant for $workspace_id $mode" >&2
                exit 1
            end
            workspace_run_configured "$runtime_id" $argv
        else
            workspace_run_configured $argv
        end
    case doctor
        work_doctor $argv
    case smoke
        set -gx WORKSPACE_TEST_SOURCE_ROOT "$SPACEWRIGHT_ROOT"
        work_smoke $argv
    case help --help -h
        printf '%s\n' \
            'usage: spacewright <command>' \
            '' \
            'commands:' \
            '  version                 print installed version' \
            '  config-check            validate effective configuration' \
            '  config-plan <target>    print a read-only workspace or mode plan' \
            '  config-v2-check [file]  validate a portable v2 configuration' \
            '  config-v2-compile [file] compile v2 to a normalized runtime plan' \
            '  config-compile          atomically compile v2 for normal runtime use' \
            '  config-status           report source and compiled runtime freshness' \
            '  config-diff             compare compiled runtime with current v2 source' \
            '  config-explain ID MODE  explain one compiled workspace plan' \
            '  inspect [--json]         discover current displays, Spaces, and windows' \
            '  plan TARGET [MODE]       compare current and desired state without mutation' \
            '  verify TARGET [MODE]     verify whether a target is converged' \
            '  capture [ID] [MODE]      print an unsaved configuration draft from a Space' \
            '  event wake [--dry-run]   deliver a wake event to the running configurator' \
            '  apply TARGET [MODE]      execute a live plan; --dry-run only previews' \
            '  recover RUN_ID           restore matched windows; --dry-run only previews' \
            '  display PROFILE [--dry-run] apply a closed display profile' \
            '  focus ID MODE [--dry-run] focus a configured workspace Space' \
            '  config-migrate-v1 [file] print a v2 migration without writing' \
            '  configure               open the local Web configurator' \
            '  run <workspace>         run a compiled workspace entry' \
            '  doctor                  run read-only dependency and config checks' \
            '  smoke                   run isolated regression checks'
    case '*'
        echo "spacewright: unknown command: $command_name" >&2
        exit 2
end
