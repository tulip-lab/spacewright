#!/usr/bin/env -S fish --no-config

set -l executable_file (path resolve (status filename))
set -l package_root (path dirname (path dirname $executable_file))
source "$package_root/conf.d/spacewright.fish"
or exit 1

set -l command_name $argv[1]
if test -n "$command_name"
    set -e argv[1]
else
    set command_name help
end

# Public direct mutations share the same coordinator as apply and interactive requests.
if contains -- "$command_name" run display focus order finalize postprocess
    and not contains -- --dry-run $argv
    if not workspace_execution_owned 2>/dev/null
        command node "$package_root/configurator/execution-cli.mjs" exec "$executable_file" "$command_name" $argv
        exit $status
    end
end

switch "$command_name"
    case pinned-workspace pinned-cleanup
        if contains -- --dry-run $argv
            printf 'dry_run=%s\n' "$command_name"
            exit 0
        end
        command node "$package_root/configurator/execution-cli.mjs" "$command_name" $argv
    case prepare-adapters
        if contains -- --dry-run $argv
            printf 'dry_run=prepare_adapters\n'
            exit 0
        end
        source "$SPACEWRIGHT_ROOT/common/workspace_prepare_adapters.fish"
        workspace_prepare_adapters
    case version --version -v
        command cat "$package_root/VERSION"
    case config-check
        workspace_config_check
    case config-plan
        workspace_config_plan $argv
    case config-v2-check
        set -l config_file $argv[1]
        test -n "$config_file"; or set config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v2.json"
        command node "$package_root/configurator/cli.mjs" validate "$config_file"
    case config-v2-compile
        set -l config_file $argv[1]
        test -n "$config_file"; or set config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v2.json"
        command node "$package_root/configurator/cli.mjs" compile "$config_file"
    case config-v3-check
        set -l config_file $argv[1]
        test -n "$config_file"; or set config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v3.json"
        command node "$package_root/configurator/cli.mjs" validate "$config_file"
    case config-v3-compile
        set -l config_file $argv[1]
        test -n "$config_file"; or set config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v3.json"
        command node "$package_root/configurator/cli.mjs" compile "$config_file" "--state-root=$SPACEWRIGHT_STATE_ROOT"
    case config-compile
        set -l config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v2.json"
        if test -r "$SPACEWRIGHT_CONFIG_ROOT/config.v3.json"
            set config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v3.json"
        end
        set -l runtime_file "$SPACEWRIGHT_CONFIG_ROOT/generated/runtime.json"
        command node "$package_root/configurator/cli.mjs" compile-to "$config_file" "$runtime_file" "--state-root=$SPACEWRIGHT_STATE_ROOT" $argv
        and printf 'compiled=%s\n' "$runtime_file"
    case config-status
        spacewright_config_status
    case config-diff
        set -l config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v2.json"
        if test -r "$SPACEWRIGHT_CONFIG_ROOT/config.v3.json"
            set config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v3.json"
        end
        set -l runtime_file "$SPACEWRIGHT_CONFIG_ROOT/generated/runtime.json"
        if not test -r "$config_file"
            echo 'spacewright: config-diff requires config.v2.json or config.v3.json' >&2
            exit 1
        end
        if not command -q node
            echo 'spacewright: config-diff requires Node.js to compile the candidate plan' >&2
            exit 1
        end
        set -l candidate (mktemp -t spacewright-runtime.XXXXXX)
        command node "$package_root/configurator/cli.mjs" compile-to "$config_file" "$candidate" "--state-root=$SPACEWRIGHT_STATE_ROOT"
        or exit 1
        diff -u "$runtime_file" "$candidate"
        set -l diff_status $status
        command rm -f "$candidate"
        if test "$diff_status" -eq 0
            echo 'runtime is current'
        else if test "$diff_status" -gt 1
            exit "$diff_status"
        end
    case config-explain
        if test (count $argv) -lt 1
            echo 'usage: spacewright config-explain <workspace> [solo|wide|tall]' >&2
            exit 2
        end
        set -l config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v2.json"
        set -l runtime_id
        if test -r "$SPACEWRIGHT_CONFIG_ROOT/config.v3.json"
            set -l resolved (spacewright_config_effective | string collect)
            set runtime_id (printf '%s\n' "$resolved" | jq -r --arg workspace "$argv[1]" 'first(.workspaces | to_entries[] | select(.value.ui.workspace_id == $workspace) | .key) // empty')
        else if test -r "$config_file"
            set runtime_id (jq -r --arg workspace "$argv[1]" --arg mode "$argv[2]" '.workspaces[$workspace].variants[$mode] as $variant | if $variant then ($variant.command // ("spacewright_" + $workspace + "_" + $mode)) else empty end' "$config_file")
        else
            set runtime_id (spacewright_config_effective | jq -r --arg workspace "$argv[1]" --arg mode "$argv[2]" 'first(.workspaces | to_entries[] | select(.value.ui.workspace_id == $workspace and .value.ui.mode == $mode) | .key) // empty')
        end
        if test -z "$runtime_id"
            echo "spacewright: no configured variant for $argv[1] $argv[2]" >&2
            exit 1
        end
        workspace_config_plan "$runtime_id"
    case inspect
        command node "$package_root/configurator/state-cli.mjs" inspect \
            "--package-root=$package_root" \
            "--config-root=$SPACEWRIGHT_CONFIG_ROOT" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT" \
            $argv
    case plan
        command node "$package_root/configurator/state-cli.mjs" plan \
            "--package-root=$package_root" \
            "--config-root=$SPACEWRIGHT_CONFIG_ROOT" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT" \
            $argv
    case verify
        command node "$package_root/configurator/state-cli.mjs" verify \
            "--package-root=$package_root" \
            "--config-root=$SPACEWRIGHT_CONFIG_ROOT" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT" \
            $argv
    case capture
        command node "$package_root/configurator/state-cli.mjs" capture \
            "--package-root=$package_root" \
            "--config-root=$SPACEWRIGHT_CONFIG_ROOT" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT" \
            $argv
    case apply
        command node "$package_root/configurator/state-cli.mjs" apply \
            "--package-root=$package_root" \
            "--config-root=$SPACEWRIGHT_CONFIG_ROOT" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT" \
            $argv
    case event
        command node "$package_root/configurator/state-cli.mjs" event \
            "--package-root=$package_root" \
            "--config-root=$SPACEWRIGHT_CONFIG_ROOT" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT" \
            $argv
    case recover repair-yabai
        command node "$package_root/configurator/state-cli.mjs" "$command_name" \
            "--package-root=$package_root" \
            "--config-root=$SPACEWRIGHT_CONFIG_ROOT" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT" \
            $argv
    case mode
        set -l mode $argv[1]
        if not contains -- "$mode" solo wide tall
            echo 'usage: spacewright mode <solo|wide|tall> [--dry-run]' >&2
            exit 2
        end
        if contains -- --dry-run $argv
            set -l profile $mode
            test "$mode" = solo; or set profile "$mode"_left
            set -l timeout_seconds "$SPACEWRIGHT_MODE_TIMEOUT_SECONDS"
            test -n "$timeout_seconds"; or set timeout_seconds 120
            printf 'dry_run=mode_transition\nmode=%s\ndisplay=display_apply_%s\nworkspace=work_%s\npolicy=latest_request_wins\ntimeout_seconds=%s\n' \
                "$mode" "$profile" "$mode" "$timeout_seconds"
            exit 0
        end
        command node "$package_root/configurator/mode-transition.mjs" run "$mode" \
            "--package-root=$package_root" \
            "--config-root=$SPACEWRIGHT_CONFIG_ROOT" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT"
    case workspace
        if test (count $argv) -lt 1
            echo 'usage: spacewright workspace <workspace> [solo|wide|tall] [--dry-run]' >&2
            exit 2
        end
        set -l workspace_id $argv[1]
        set -l mode $argv[2]
        if test -r "$SPACEWRIGHT_CONFIG_ROOT/config.v3.json"; and not contains -- "$mode" solo wide tall
            set -l setup_command activate
            if contains -- --dry-run $argv
                set setup_command status
            end
            set -l activation (command node "$package_root/configurator/setup-cli.mjs" "$setup_command" \
                    "--config-root=$SPACEWRIGHT_CONFIG_ROOT" \
                    "--state-root=$SPACEWRIGHT_STATE_ROOT")
            or exit 1
            if test "$setup_command" = status; and test (printf '%s\n' "$activation" | jq -r '.ready') != true
                echo 'spacewright: current hardware/display setup has not been confirmed' >&2
                exit 1
            end
            set mode (printf '%s\n' "$activation" | jq -r '.compatibilityMode')
        end
        if not string match -qr '^[a-z][a-z0-9_]*$' -- "$workspace_id"; or not contains -- "$mode" solo wide tall
            echo 'usage: spacewright workspace <workspace> [solo|wide|tall] [--dry-run]' >&2
            exit 2
        end
        set -l effective_config (spacewright_config_effective | string collect)
        or exit 1
        set -l workspace_label (printf '%s\n' "$effective_config" | jq -r --arg workspace "$workspace_id" --arg mode "$mode" --arg runtime_key "$workspace_id"_"$mode" '
            (.workspaces // {}) as $workspaces
            | (first($workspaces[]? | select(.ui.workspace_id == $workspace and .ui.mode == $mode) | .ui.name) // empty)
                // (if ($workspaces | type) == "object" then ($workspaces[$runtime_key].label // empty) else empty end)
        ')
        if test -z "$workspace_label"
            echo "spacewright: no configured variant for $workspace_id $mode" >&2
            exit 1
        end
        if contains -- --dry-run $argv
            printf 'dry_run=workspace_transition\nworkspace=%s\nmode=%s\nscope=target_only\nfinalization=none\n' "$workspace_id" "$mode"
            exit 0
        end
        command node "$package_root/configurator/mode-transition.mjs" workspace "$workspace_id" "$mode" \
            "--label=$workspace_label · $mode" \
            "--package-root=$package_root" \
            "--config-root=$SPACEWRIGHT_CONFIG_ROOT" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT"
    case mode-cancel
        command node "$package_root/configurator/mode-transition.mjs" cancel \
            "--package-root=$package_root" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT"
    case mode-status
        command node "$package_root/configurator/mode-transition.mjs" status \
            "--package-root=$package_root" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT"
    case transition-history
        command node "$package_root/configurator/mode-transition.mjs" history \
            "--package-root=$package_root" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT"
    case display
        set -l profile $argv[1]
        if not contains -- "$profile" solo wide_left tall_left
            echo 'usage: spacewright display <solo|wide_left|tall_left> [--dry-run]' >&2
            exit 2
        end
        if contains -- --dry-run $argv
            printf 'dry_run=display_apply_%s\n' "$profile"
            exit 0
        end
        switch "$profile"
            case solo
                display_apply_solo
            case wide_left
                display_apply_wide_left
            case tall_left
                display_apply_tall_left
        end
    case focus
        if test (count $argv) -lt 1
            echo 'usage: spacewright focus <workspace> [solo|wide|tall] [--dry-run]' >&2
            exit 2
        end
        set -l workspace_id $argv[1]
        set -l mode $argv[2]
        set -l label
        if test -r "$SPACEWRIGHT_CONFIG_ROOT/config.v3.json"
            set -l effective (spacewright_config_effective | string collect)
            set label (printf '%s\n' "$effective" | jq -r --arg workspace "$workspace_id" 'first(.workspaces[]? | select(.ui.workspace_id == $workspace) | .label) // empty')
            set mode (printf '%s\n' "$effective" | jq -r '.active_setup // empty')
        else if not contains -- "$mode" solo wide tall
            echo 'spacewright: focus mode must be solo, wide, or tall' >&2
            exit 2
        end
        set -l config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v2.json"
        if test -z "$label"; and not test -r "$config_file"
            echo 'spacewright: focus requires config.v2.json' >&2
            exit 1
        end
        if test -z "$label"
            set label (jq -r --arg workspace "$workspace_id" --arg mode "$mode" '.workspaces[$workspace] as $w | $w.variants[$mode] as $v | if ($w and $v) then ($v.spaceLabel // ($w.spaceLabel + "_" + $mode)) else empty end' "$config_file")
        end
        if test -z "$label"
            echo "spacewright: no configured variant for $workspace_id $mode" >&2
            exit 1
        end
        if contains -- --dry-run $argv
            printf 'dry_run=focus_space\nlabel=%s\n' "$label"
            exit 0
        end
        ws_focus_space "$label"; or exit 1
        set -l focused (ws_query_current_space spacewright_focus verify); or exit 1
        printf '%s\n' "$focused" | jq -e --arg label "$label" '.label == $label' >/dev/null
        or begin
            echo '[WARN] workspace focus did not reach the requested Space' >&2
            exit 1
        end
    case order
        set -l mode $argv[1]
        if not contains -- "$mode" solo wide tall
            echo 'usage: spacewright order <solo|wide|tall> [--dry-run]' >&2
            exit 2
        end
        if contains -- --dry-run $argv
            workspace_order_mode_spaces $argv
        else
            workspace_order_and_verify_mode_spaces "$mode"
        end
    case finalize
        set -l mode $argv[1]
        if not contains -- "$mode" solo wide tall
            echo 'usage: spacewright finalize <solo|wide|tall> [--dry-run]' >&2
            exit 2
        end
        if contains -- --dry-run $argv
            printf 'dry_run=workspace_finalize_mode\nmode=%s\nsteps=sandbox cleanup order_verify restore_focus\n' "$mode"
            exit 0
        end
        if set -q SPACEWRIGHT_EXECUTION_ENVELOPE
            command node "$package_root/configurator/execution-cli.mjs" pinned-finalize
        else
            workspace_finalize_mode $mode
        end
    case postprocess
        set -l hook $argv[1]
        if not contains -- "$hook" gtd_ai_expand_hermes_when_alone workspace_reconcile_primary_fixed_spaces
            echo 'usage: spacewright postprocess <gtd_ai_expand_hermes_when_alone|workspace_reconcile_primary_fixed_spaces> [--dry-run]' >&2
            exit 2
        end
        if contains -- --dry-run $argv
            printf 'dry_run=postprocess\nhook=%s\n' "$hook"
            exit 0
        end
        if set -q SPACEWRIGHT_EXECUTION_ENVELOPE
            command node "$package_root/configurator/execution-cli.mjs" pinned-postprocess "$hook"
        else
            $hook
        end
    case config-migrate-v1
        set -l config_file $argv[1]
        test -n "$config_file"; or set config_file (spacewright_config_user_file)
        command node "$package_root/configurator/cli.mjs" migrate-v1 "$config_file"
    case config-migrate-v2
        set -l config_file $argv[1]
        test -n "$config_file"; or set config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v2.json"
        command node "$package_root/configurator/cli.mjs" migrate-v2 "$config_file"
    case setup
        set -l setup_command $argv[1]
        contains -- "$setup_command" detect status confirm activate; or begin
            echo 'usage: spacewright setup <detect|status|confirm|activate> [hardware-profile] [setup]' >&2
            exit 2
        end
        set -e argv[1]
        command node "$package_root/configurator/setup-cli.mjs" "$setup_command" \
            "--config-root=$SPACEWRIGHT_CONFIG_ROOT" \
            "--state-root=$SPACEWRIGHT_STATE_ROOT" \
            $argv
    case configure
        if not command -q node
            echo 'spacewright configure requires Node.js 20 or newer' >&2
            exit 1
        end
        command node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 20 ? 0 : 1)'
        or begin
            echo 'spacewright configure requires Node.js 20 or newer' >&2
            exit 1
        end
        command node "$package_root/configurator/server.mjs" "--package-root=$package_root" "--config-root=$SPACEWRIGHT_CONFIG_ROOT" "--state-root=$SPACEWRIGHT_STATE_ROOT" $argv
    case run
        if set -q SPACEWRIGHT_EXECUTION_ENVELOPE; and contains -- "$argv[2]" solo wide tall; and not contains -- --dry-run $argv
            command node "$package_root/configurator/execution-cli.mjs" pinned-workspace "$argv[1]"
            exit $status
        end
        if not set -q SPACEWRIGHT_EXECUTION_ENVELOPE
            and test "$SPACEWRIGHT_CONFIG_DISABLE" != 1
            and begin; test -r "$SPACEWRIGHT_CONFIG_ROOT/config.v2.json"; or test -r "$SPACEWRIGHT_CONFIG_ROOT/config.v3.json"; end
            if string match -q 'work_*' -- "$argv[1]"
                set -l mode (string replace work_ '' -- "$argv[1]")
                command node "$package_root/configurator/state-cli.mjs" apply "$mode" "--package-root=$package_root" "--config-root=$SPACEWRIGHT_CONFIG_ROOT" "--state-root=$SPACEWRIGHT_STATE_ROOT" $argv[2..-1]
            else
                set -l effective (spacewright_config_effective); or exit 1
                set -l workspace "$argv[1]"
                set -l mode "$argv[2]"
                set -l option_start 3
                if not contains -- "$mode" solo wide tall
                    set option_start 2
                    set workspace (printf '%s\n' "$effective" | jq -r --arg id "$argv[1]" '.workspaces[$id].ui.workspace_id // empty')
                    set mode (printf '%s\n' "$effective" | jq -r --arg id "$argv[1]" '.workspaces[$id].ui.mode // empty')
                end
                command node "$package_root/configurator/state-cli.mjs" apply "$workspace" "$mode" "--package-root=$package_root" "--config-root=$SPACEWRIGHT_CONFIG_ROOT" "--state-root=$SPACEWRIGHT_STATE_ROOT" $argv[$option_start..-1]
            end
            exit $status
        end
        if string match -q 'work_*' -- "$argv[1]"
            workspace_run_configured_mode $argv
        else if contains -- "$argv[2]" solo wide tall
            set -l workspace_id $argv[1]
            set -l mode $argv[2]
            set -e argv[1..2]
            set -l runtime_id "$workspace_id"_"$mode"
            set -l config_file "$SPACEWRIGHT_CONFIG_ROOT/config.v2.json"
            if test -r "$SPACEWRIGHT_CONFIG_ROOT/config.v3.json"
                set runtime_id (spacewright_config_effective | jq -r --arg workspace "$workspace_id" --arg mode "$mode" 'first(.workspaces | to_entries[] | select(.value.ui.workspace_id == $workspace and .value.ui.mode == $mode) | .key) // empty')
            else if test -r "$config_file"
                set runtime_id (jq -r --arg workspace "$workspace_id" --arg mode "$mode" '.workspaces[$workspace].variants[$mode] as $variant | if $variant then ($variant.command // ("spacewright_" + $workspace + "_" + $mode)) else empty end' "$config_file")
            end
            if test -z "$runtime_id"
                echo "spacewright: no configured variant for $workspace_id $mode" >&2
                exit 1
            end
            workspace_run_configured "$runtime_id" $argv
        else
            workspace_run_configured $argv
        end
    case doctor
        work_doctor $argv
    case smoke
        set -gx WORKSPACE_TEST_SOURCE_ROOT "$SPACEWRIGHT_ROOT"
        work_smoke $argv
    case help --help -h
        printf '%s\n' \
            'usage: spacewright <command>' \
            '' \
            'commands:' \
            '  version                 print installed version' \
            '  config-check            validate effective configuration' \
            '  config-plan <target>    print a read-only workspace or mode plan' \
            '  config-v2-check [file]  validate a portable v2 configuration' \
            '  config-v2-compile [file] compile v2 to a normalized runtime plan' \
            '  config-v3-check [file]  validate a hardware-aware v3 configuration' \
            '  config-v3-compile [file] compile the confirmed v3 setup' \
            '  config-compile          atomically compile the active portable configuration' \
            '  config-status           report source and compiled runtime freshness' \
            '  config-diff             compare compiled runtime with current v2 source' \
            '  config-explain ID MODE  explain one compiled workspace plan' \
            '  inspect [--json]         discover current displays, Spaces, and windows' \
            '  plan TARGET [MODE]       compare current and desired state without mutation' \
            '  verify TARGET [MODE]     verify whether a target is converged' \
            '  capture [ID] [MODE]      print an unsaved configuration draft from a Space' \
            '  event wake [--dry-run]   deliver a wake event to the running configurator' \
            '  apply TARGET [MODE]      execute a live plan; --dry-run only previews' \
            '  recover RUN_ID           restore matched windows; --dry-run only previews' \
            '  repair-yabai [--dry-run] safely restart yabai; --resume=ID restores a checkpoint' \
            '  mode MODE                switch display and workspace with progress feedback' \
            '  workspace ID [MODE]      arrange one workspace; v3 resolves configuration automatically' \
            '  setup COMMAND            detect, confirm, activate, or report the current display setup' \
            '  mode-cancel              cancel the active mode transition' \
            '  mode-status              show the latest mode transition state' \
            '  transition-history       show recent mode and workspace transitions' \
            '  display PROFILE [--dry-run] apply a closed display profile' \
            '  focus ID MODE [--dry-run] focus a configured workspace Space' \
            '  order MODE [--dry-run]   order configured Spaces for one mode' \
            '  finalize MODE [--dry-run] collect Sandbox, clean, order, and restore focus' \
            '  postprocess HOOK [--dry-run] run a closed reconciliation hook' \
            '  config-migrate-v1 [file] print a v2 migration without writing' \
            '  config-migrate-v2 [file] print a hardware-aware v3 migration without writing' \
            '  configure               open the local Web configurator' \
            '  run <workspace>         run a compiled workspace entry' \
            '  doctor                  run read-only dependency and config checks' \
            '  smoke                   run isolated regression checks'
    case '*'
        echo "spacewright: unknown command: $command_name" >&2
        exit 2
end
