function display_reload
    source ~/.config/fish/functions/workspace/display/display_apply_wide_left.fish
    source ~/.config/fish/functions/workspace/display/display_apply_tall_left.fish

    source ~/.config/fish/functions/workspace/display/display_wide_left.fish
    source ~/.config/fish/functions/workspace/display/display_tall_left.fish
    source ~/.config/fish/functions/workspace/display/display_solo.fish
    source ~/.config/fish/functions/workspace/display/display_dual_external.fish
end