# Optional automatic bindings for a confirmed v3 setup.
alt + shift - 0 : fish -lc 'spacewright mode auto'
alt + shift - 1 : fish -lc 'spacewright workspace coding_editor'
alt + shift - d : fish -lc 'spacewright setup show'
ctrl + alt + shift - d : fish -lc 'spacewright configure --view=hardware'
ctrl + alt - escape : fish -lc 'spacewright mode-cancel'
# Deliberate display changes remain available as: spacewright mode wide/tall/solo
