{
  "version": 1,
  "apps": {
    "code": { "names": ["Code", "Visual Studio Code"] },
    "claude": { "names": ["Claude"] },
    "chatgpt": { "names": ["ChatGPT"] },
    "hermes": { "names": ["Hermes"] },
    "input_source_pro": { "names": ["Input Source Pro"] },
    "obsidian": { "names": ["Obsidian"] },
    "zotero": { "names": ["Zotero"] },
    "thunderbird": { "names": ["Thunderbird", "thunderbird"] },
    "word": { "names": ["Microsoft Word"] },
    "powerpoint": { "names": ["Microsoft PowerPoint"] },
    "outlook": { "names": ["Microsoft Outlook"] },
    "zoom": { "names": ["zoom.us", "Zoom"] },
    "teams": { "names": ["Microsoft Teams", "MSTeams"] },
    "dia": { "names": ["Dia"] },
    "finder": { "names": ["Finder"] },
    "preview": { "names": ["Preview", "预览"] },
    "notes": { "names": ["Notes"] },
    "calendar": { "names": ["Calendar"] },
    "reminders": { "names": ["Reminders"] },
    "wechat": { "names": ["WeChat"] },
    "keybase": { "names": ["Keybase"] },
    "messages": { "names": ["Messages"] },
    "dingtalk": { "names": ["DingTalk", "钉钉"] },
    "whatsapp": { "names": ["WhatsApp"] },
    "facetime": { "names": ["FaceTime"] },
    "warp": { "names": ["Warp"] },
    "smartgit": { "names": ["SmartGit"] },
    "keepassx": { "names": ["KeePassXC", "KeePassX"] },
    "flclash": { "names": ["FlClash"] },
    "thaw": { "names": ["Thaw"] },
    "portfolio_performance": { "names": ["Portfolio Performance"] }
  },
  "layouts": {
    "coding_editor_wide": [
      { "role": "primary", "grid": "1:3:1:0:2:1" },
      { "role": "helper", "grid": "1:3:0:0:1:1" }
    ],
    "single_full": [
      { "role": "primary", "grid": "1:1:0:0:1:1" }
    ]
  },
  "workspaces": {
    "coding_editor_wide": {
      "label": "coding_editor_wide",
      "display_role": "wide",
      "space_layout": "float",
      "windows": [
        {
          "role": "primary",
          "app_key": "code",
          "required": true,
          "selector": { "movable": true, "visible": true }
        },
        {
          "role": "helper",
          "app_key": "chatgpt",
          "required": false,
          "selector": { "movable": true, "visible": true }
        }
      ],
      "layout_ref": "coding_editor_wide",
      "primary_alone_layout_ref": "single_full",
      "cleanup": {
        "family": "coding",
        "opposite_modes": ["solo", "tall"]
      }
    }
  },
  "modes": {
    "coding_wide": ["coding_editor_wide"]
  }
}
