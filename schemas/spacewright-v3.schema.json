{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spacewright.local/schemas/spacewright-v3.schema.json",
  "title": "SpaceWright hardware-aware portable configuration v3",
  "type": "object",
  "required": ["version", "apps", "displayRoles", "workspaces", "hardwareProfiles"],
  "properties": {
    "version": { "const": 3 },
    "metadata": {
      "type": "object",
      "properties": { "name": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "apps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/app" }
    },
    "aiProviders": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/aiProvider" }
    },
    "aiRouting": { "$ref": "#/$defs/aiRouting" },
    "displayRoles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/displayRole" }
    },
    "workspaces": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/workspace" }
    },
    "hardwareProfiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/hardwareProfile" }
    },
    "shortcuts": { "type": "array", "items": { "$ref": "#/$defs/shortcut" } },
    "settings": {
      "type": "object",
      "properties": {
        "executionBudgets": {
          "type": "object",
          "properties": {
            "confirmation": { "type": "integer", "minimum": 0, "maximum": 4096 },
            "commandRetry": { "type": "integer", "minimum": 0, "maximum": 16 },
            "appRecovery": { "type": "integer", "minimum": 0, "maximum": 64 },
            "serviceRecovery": { "type": "integer", "minimum": 0, "maximum": 4 },
            "reconciliation": { "type": "integer", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": false
        },
        "eventAutomationEnabled": { "type": "boolean" },
        "cleanupEmptySpaces": { "enum": ["managed", "all", "none"] },
        "tallTopPercent": { "type": "integer", "minimum": 35, "maximum": 65 },
        "topologyStableSamples": { "type": "integer", "minimum": 1, "maximum": 12 },
        "topologyCooldownSeconds": { "type": "number", "minimum": 0, "maximum": 600 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "app": {
      "type": "object",
      "required": ["name", "match"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "match": {
          "type": "object",
          "required": ["appNames"],
          "properties": {
            "appNames": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "bundleIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "aiProvider": {
      "type": "object",
      "required": ["name", "app"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "app": { "$ref": "#/$defs/id" } },
      "additionalProperties": false
    },
    "aiRouting": {
      "type": "object",
      "required": ["assignments", "fallbackWorkspace", "focusOwner"],
      "properties": {
        "assignments": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": {
            "type": "object",
            "required": ["role", "provider"],
            "properties": {
              "role": { "$ref": "#/$defs/id" },
              "provider": { "$ref": "#/$defs/id" },
              "configurationOverrides": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/id" } },
              "configurationRoleOverrides": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/id" } }
            },
            "additionalProperties": false
          }
        },
        "fallbackWorkspace": { "$ref": "#/$defs/id" },
        "focusOwner": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "displayRole": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "portableMatch": {
          "type": "object",
          "properties": { "builtIn": { "type": "boolean" }, "orientation": { "enum": ["wide", "tall"] } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "selector": {
      "type": "object",
      "properties": {
        "movable": { "type": "boolean" },
        "visible": { "type": "boolean" },
        "non_empty_title": { "type": "boolean" },
        "title_include": { "type": "string" },
        "title_exclude": { "type": "string" },
        "role": { "type": "string", "minLength": 1 },
        "subrole": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "required": ["app", "required"],
      "properties": {
        "app": { "$ref": "#/$defs/id" },
        "required": { "type": "boolean" },
        "ownership": { "enum": ["lastApplicable", "independent"] },
        "cardinality": { "enum": ["one", "many"] },
        "selector": { "$ref": "#/$defs/selector" }
      },
      "additionalProperties": false
    },
    "layout": {
      "oneOf": [
        { "type": "object", "required": ["type", "role"], "properties": { "type": { "const": "window" }, "role": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "empty" } }, "additionalProperties": false },
        {
          "type": "object",
          "required": ["type", "direction", "weights", "children"],
          "properties": {
            "type": { "const": "split" },
            "direction": { "enum": ["rows", "columns"] },
            "weights": { "type": "array", "minItems": 2, "items": { "type": "integer", "minimum": 1 } },
            "children": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/layout" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "regions"],
          "properties": {
            "type": { "const": "canvas" },
            "regions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["role"],
                "properties": {
                  "role": { "$ref": "#/$defs/id" },
                  "grid": { "type": "string", "pattern": "^[0-9]+:[0-9]+:[0-9]+:[0-9]+:[0-9]+:[0-9]+$" },
                  "move_abs": { "type": "string" },
                  "resize_abs": { "type": "string" }
                },
                "anyOf": [{ "required": ["grid"] }, { "required": ["move_abs"] }, { "required": ["resize_abs"] }],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "runtime": {
      "type": "object",
      "properties": {
        "runner": { "enum": ["primary_helper", "office_document", "gtd_support", "gtd_review", "gtd_meeting", "gtd_ai", "fixed_adapter", "generic_layout"] },
        "displayRole": { "type": "string", "minLength": 1 },
        "runnerOptions": { "type": "object" },
        "cleanup": { "type": "object" },
        "primaryAloneLayout": { "type": "array" },
        "windows": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "required": ["layout"],
      "properties": {
        "layout": { "$ref": "#/$defs/layout" },
        "command": { "$ref": "#/$defs/id" },
        "spaceLabel": { "type": "string", "minLength": 1 },
        "activation": {
          "oneOf": [
            { "type": "object", "required": ["type"], "properties": { "type": { "const": "always" } }, "additionalProperties": false },
            { "type": "object", "required": ["type", "role"], "properties": { "type": { "const": "windowPresent" }, "role": { "$ref": "#/$defs/id" } }, "additionalProperties": false }
          ]
        },
        "runtime": { "$ref": "#/$defs/runtime" }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "required": ["name", "spaceLabel", "windows", "configurations"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "spaceLabel": { "type": "string", "minLength": 1 },
        "windows": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/window" } },
        "defaultConfiguration": { "$ref": "#/$defs/id" },
        "configurations": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/configuration" } }
      },
      "additionalProperties": false
    },
    "displayRequirement": {
      "type": "object",
      "properties": {
        "role": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["built_in", "external", "sidecar"] },
        "orientation": { "enum": ["wide", "tall", "square"] }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "setup": {
      "type": "object",
      "required": ["name", "compatibilityMode", "match", "lanes", "workspaceConfigurations"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "compatibilityMode": { "enum": ["solo", "wide", "tall"] },
        "match": {
          "type": "object",
          "required": ["displays"],
          "properties": {
            "displays": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/displayRequirement" } },
            "allowAdditionalDisplays": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role", "workspaceOrder"],
            "properties": {
              "role": { "$ref": "#/$defs/id" },
              "workspaceOrder": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
            },
            "additionalProperties": false
          }
        },
        "workspaceConfigurations": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/id" } },
        "displayConfig": { "type": "object" },
        "focusWorkspace": { "$ref": "#/$defs/id" },
        "cleanup": { "type": "array", "items": { "type": "string" } },
        "contextualApps": { "type": "array", "items": { "type": "object" } },
        "postprocessors": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "hardwareProfile": {
      "type": "object",
      "required": ["name", "match", "setups"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "match": {
          "type": "object",
          "required": ["family"],
          "properties": { "family": { "enum": ["macbook", "mac_mini", "other"] } },
          "additionalProperties": false
        },
        "setups": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/setup" } }
      },
      "additionalProperties": false
    },
    "shortcut": {
      "type": "object",
      "required": ["id", "keys", "action"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "keys": {
          "type": "object",
          "required": ["modifiers", "key"],
          "properties": {
            "modifiers": { "type": "array", "uniqueItems": true, "items": { "enum": ["cmd", "ctrl", "alt", "shift", "fn"] } },
            "key": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "action": {
          "oneOf": [
            { "type": "object", "required": ["type", "workspace"], "properties": { "type": { "const": "activateWorkspace" }, "workspace": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
            { "type": "object", "required": ["type", "hardwareProfile", "setup"], "properties": { "type": { "const": "activateSetup" }, "hardwareProfile": { "$ref": "#/$defs/id" }, "setup": { "$ref": "#/$defs/id" } }, "additionalProperties": false }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
