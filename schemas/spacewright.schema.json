{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tulip-lab/spacewright/schemas/spacewright.schema.json",
  "title": "SpaceWright configuration",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "apps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["names"],
        "properties": {
          "names": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "layouts": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["role"],
          "properties": {
            "role": { "type": "string", "minLength": 1 },
            "grid": { "type": "string", "pattern": "^[0-9]+:[0-9]+:[0-9]+:[0-9]+:[0-9]+:[0-9]+$" },
            "move_abs": { "type": "string" },
            "resize_abs": { "type": "string" }
          },
          "anyOf": [
            { "required": ["grid"] },
            { "required": ["move_abs"] },
            { "required": ["resize_abs"] }
          ],
          "additionalProperties": false
        }
      }
    },
    "workspaces": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["runner", "label", "display_role", "space_layout", "windows", "layout_ref"],
        "properties": {
          "runner": {
            "enum": [
              "primary_helper",
              "office_document",
              "gtd_support",
              "gtd_review",
              "gtd_meeting",
              "gtd_ai",
              "fixed_adapter",
              "generic_layout"
            ]
          },
          "runner_options": {
            "type": "object",
            "properties": {
              "mode": { "enum": ["solo", "wide", "tall"] },
              "primary_space_fallback": { "type": "boolean" },
              "adapter": { "enum": ["coding_control", "gtd_chat", "gtd_calendar"] }
            },
            "additionalProperties": false
          },
          "label": { "type": "string", "minLength": 1 },
          "display_role": { "enum": ["primary", "external", "solo", "wide", "tall", "auto_external"] },
          "space_layout": { "enum": ["float", "bsp", "stack"] },
          "windows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["role", "app_key", "required"],
              "properties": {
                "role": { "type": "string", "minLength": 1 },
                "app_key": { "type": "string", "minLength": 1 },
                "required": { "type": "boolean" },
                "selector": {
                  "type": "object",
                  "properties": {
                    "movable": { "type": "boolean" },
                    "visible": { "type": "boolean" },
                    "non_empty_title": { "type": "boolean" },
                    "title_include": { "type": "string" },
                    "title_exclude": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "layout_ref": { "type": "string", "minLength": 1 },
          "activation": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["always", "windowPresent"] },
              "role": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "primary_alone_layout_ref": { "type": "string", "minLength": 1 },
          "cleanup": {
            "type": "object",
            "properties": {
              "family": { "type": "string", "minLength": 1 },
              "opposite_modes": {
                "type": "array",
                "items": { "enum": ["solo", "wide", "tall"] },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "modes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["display_mode", "steps"],
        "properties": {
          "display_mode": { "enum": ["solo", "wide", "tall", "auto"] },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "oneOf": [
                {
                  "required": ["workspace"],
                  "properties": { "workspace": { "type": "string", "minLength": 1 } },
                  "additionalProperties": false
                },
                {
                  "required": ["mode"],
                  "properties": {
                    "mode": { "enum": ["coding_solo", "gtd_solo_all", "office_wide", "office_tall"] }
                  },
                  "additionalProperties": false
                },
                {
                  "required": ["postprocessor"],
                  "properties": {
                    "postprocessor": {
                      "enum": ["gtd_ai_expand_hermes_when_alone", "workspace_reconcile_primary_fixed_spaces"]
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "cleanup": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z_]+:(solo|wide|tall)$" },
            "uniqueItems": true
          },
          "contextual_apps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["app_key", "workspace_ids", "fallback_workspace_id", "focus_owner"],
              "properties": {
                "app_key": { "type": "string", "minLength": 1 },
                "workspace_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "fallback_workspace_id": { "type": "string", "minLength": 1 },
                "focus_owner": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
